# Microdados brutos (NUNCA commitar)
data/raw/*
!data/raw/.gitkeep

# Dados processados (reproduzíveis via tar_make — não versionados)
data/processed/*
!data/processed/.gitkeep

# R / RStudio
.Rproj.user/
.Rhistory
.Rdata
.Ruserdata
.Renviron

# renv (mantém apenas lockfile e activate.R)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# targets (artefatos do pipeline; mantém só _targets.R)
_targets/

# Quarto / RMarkdown
*_files/
*_cache/
.quarto/
# HTMLs e PDFs: ignora por padrão, MAS permite os relatórios renderizados
*.html
*.pdf
!outputs/reports/*.html
!outputs/reports/*.pdf
!docs/**/*.pdf

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Credenciais e segredos
*.json.bak
secrets.*
.env
.env.*
